# Supabase → Connect → Transaction pooler (port 6543), bukan koneksi langsung 5432 (IPv6 saja)
DATABASE_URL=
# URL project Supabase, mis. https://xxxx.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) atau service_role key, BUKAN publishable key; dipakai untuk upload Storage
SUPABASE_SERVICE_ROLE_KEY=
# URL publik folder media: <SUPABASE_URL>/storage/v1/object/public/media (dipakai juga di browser)
NEXT_PUBLIC_MEDIA_BASE_URL=
# Midtrans sandbox: Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# true hanya di produksi
MIDTRANS_IS_PRODUCTION=false
# URL publik HTTPS ke /api/webhooks/midtrans (mis. tunnel ngrok/cloudflared saat dev)
MIDTRANS_NOTIFICATION_URL=
# URL dasar aplikasi
APP_URL=http://localhost:3000
# Rahasia penanda tangan cookie, minimal 32 karakter acak
COOKIE_SECRET=
# Kunci AES-256-GCM: base64 dari tepat 32 byte acak
DATA_ENCRYPTION_KEY=
# Cloudflare Turnstile; kosong = test key resmi yang selalu lolos
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# SMTP cadangan bila pengaturan SMTP di panel kosong
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
