{
  "name": "anytix",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit",
    "test:db": "vitest run --no-file-parallelism tests/db",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "admin:create": "tsx --env-file=.env.local scripts/create-admin.ts",
    "admin:reset-2fa": "tsx --env-file=.env.local scripts/reset-2fa.ts",
    "worker": "tsx --env-file=.env.local worker/index.ts",
    "db:apply": "tsx --env-file=.env.local scripts/apply-sql.ts"
  },
  "dependencies": {
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
