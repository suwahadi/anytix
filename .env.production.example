# Template .env.local untuk server produksi (VPS aaPanel). Salin ke .env.local di folder aplikasi, isi rahasianya, jangan di-commit.

# Supabase → Connect → Transaction pooler (port 6543)
DATABASE_URL=
# Supabase → Connect → Session pooler (port 5432); dipakai deploy/backup-db.sh karena pg_dump tidak bisa lewat transaction pooler
DATABASE_URL_DIRECT=
SUPABASE_URL=
# Secret key (sb_secret_...) atau service_role key
SUPABASE_SERVICE_ROLE_KEY=
# <SUPABASE_URL>/storage/v1/object/public/media; dibaca saat build, jadi build ulang bila berubah
NEXT_PUBLIC_MEDIA_BASE_URL=

# Midtrans produksi: Dashboard (mode Production) → Settings → Access Keys
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
# Kosongkan: URL notifikasi diatur di dashboard Midtrans (https://anytix.web.id/api/webhooks/midtrans)
MIDTRANS_NOTIFICATION_URL=

# Harus https; dibaca juga saat build (HSTS, cookie Secure)
APP_URL=https://anytix.web.id

# Minimal 32 karakter acak, mis. hasil: openssl rand -base64 48
COOKIE_SECRET=
# Base64 dari tepat 32 byte acak: openssl rand -base64 32. JANGAN diganti setelah ada data (nomor identitas & password SMTP terenkripsi dengannya)
DATA_ENCRYPTION_KEY=

# Cloudflare Turnstile untuk domain anytix.web.id (bukan test key)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SMTP cadangan bila pengaturan SMTP di panel kosong
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AnyTix <noreply@anytix.web.id>"

# Aplikasi berada di belakang Nginx: IP klien dibaca dari X-Real-IP saja
TRUST_PROXY=true
# Pengali batas permintaan per IP; naikkan hanya selama uji beban k6, lalu kembalikan ke 1
RATE_LIMIT_SCALE=1

# Biarkan tidak ada di server produksi. deploy.sh memberi DB_WRITE_ALLOWED=true hanya untuk migrasi.
# DB_TESTS_ALLOWED=
# DB_WRITE_ALLOWED=
